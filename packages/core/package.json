{
  "name": "lazy-avatars",
  "version": "1.1.2",
  "description": "Deterministic SVG avatar library for people, teams, servers and bots: 13 original collections, zero core runtime dependencies.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulaquiin/lazy-avatars.git",
    "directory": "packages/core"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mosaic": {
      "types": "./dist/mosaic.d.ts",
      "import": "./dist/mosaic.js"
    },
    "./monogram": {
      "types": "./dist/monogram.d.ts",
      "import": "./dist/monogram.js"
    },
    "./rack": {
      "types": "./dist/rack.d.ts",
      "import": "./dist/rack.js"
    },
    "./siesta": {
      "types": "./dist/siesta.d.ts",
      "import": "./dist/siesta.js"
    },
    "./origami": {
      "types": "./dist/origami.d.ts",
      "import": "./dist/origami.js"
    },
    "./pantry": {
      "types": "./dist/pantry.d.ts",
      "import": "./dist/pantry.js"
    },
    "./deco": {
      "types": "./dist/deco.d.ts",
      "import": "./dist/deco.js"
    },
    "./latte": {
      "types": "./dist/latte.d.ts",
      "import": "./dist/latte.js"
    },
    "./constellation": {
      "types": "./dist/constellation.d.ts",
      "import": "./dist/constellation.js"
    },
    "./tinbot": {
      "types": "./dist/tinbot.d.ts",
      "import": "./dist/tinbot.js"
    },
    "./orbit": {
      "types": "./dist/orbit.d.ts",
      "import": "./dist/orbit.js"
    },
    "./mission": {
      "types": "./dist/mission.d.ts",
      "import": "./dist/mission.js"
    },
    "./helmet": {
      "types": "./dist/helmet.d.ts",
      "import": "./dist/helmet.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./web-component": {
      "types": "./dist/web-component.d.ts",
      "import": "./dist/web-component.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    }
  },
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "bin": {
    "lazy-avatars": "./dist/cli-bin.js",
    "lazy-avatars-http": "./dist/http-bin.js"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "homepage": "https://paulaquiin.github.io/lazy-avatars/",
  "bugs": {
    "url": "https://github.com/paulaquiin/lazy-avatars/issues"
  },
  "keywords": [
    "avatar",
    "avatars",
    "avatar-generator",
    "identicon",
    "svg",
    "deterministic",
    "react",
    "web-component",
    "typescript",
    "boring-avatars-alternative",
    "dicebear-alternative"
  ]
}
