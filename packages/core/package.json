{
  "name": "lazy-avatars",
  "version": "0.2.0",
  "description": "Deterministic, self-contained SVG avatars with a dependency-free core",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulaquiin/lazy-avatars.git",
    "directory": "packages/core"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mosaic": {
      "types": "./dist/mosaic.d.ts",
      "import": "./dist/mosaic.js"
    },
    "./monogram": {
      "types": "./dist/monogram.d.ts",
      "import": "./dist/monogram.js"
    },
    "./rack": {
      "types": "./dist/rack.d.ts",
      "import": "./dist/rack.js"
    },
    "./siesta": {
      "types": "./dist/siesta.d.ts",
      "import": "./dist/siesta.js"
    },
    "./origami": {
      "types": "./dist/origami.d.ts",
      "import": "./dist/origami.js"
    },
    "./pantry": {
      "types": "./dist/pantry.d.ts",
      "import": "./dist/pantry.js"
    },
    "./deco": {
      "types": "./dist/deco.d.ts",
      "import": "./dist/deco.js"
    },
    "./latte": {
      "types": "./dist/latte.d.ts",
      "import": "./dist/latte.js"
    },
    "./constellation": {
      "types": "./dist/constellation.d.ts",
      "import": "./dist/constellation.js"
    }
  },
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  }
}
